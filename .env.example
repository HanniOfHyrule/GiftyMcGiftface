# Copy to .env and fill in. Never commit .env.

# Database (Postgres in docker-compose)
DATABASE_USERNAME=gifty
DATABASE_PASSWORD=change-me-to-a-long-random-password
DATABASE_NAME=gifty
# Only needed when running the backend outside Docker (defaults: localhost:5433)
# DATABASE_HOST=localhost
# DATABASE_PORT=5433

# Auth — at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Optional, falls back to JWT_SECRET
JWT_REFRESH_SECRET=

# Public address of the app (used for links and the Todoist OAuth redirect)
APP_URL=http://localhost:3000
FRONTEND_PORT=3000
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting)
TRUST_PROXY=1
TZ=Europe/Berlin
BACKUP_KEEP_DAYS=14

# Todoist integration (optional)
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Optional, falls back to JWT_SECRET
TODOIST_ENCRYPTION_KEY=
